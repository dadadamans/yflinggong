<view class="page">
  <view class="hero-card">
    <text class="eyebrow">雇主端</text>
    <text class="page-title">任务管理</text>
    <text class="page-desc">这里单独查看已发布任务的状态，不再和发布表单混在一起。发布、查看、完成，三个动作现在分得更清楚。</text>
  </view>

  <view class="section">
    <view class="nav-strip nav-strip-four">
      <navigator url="/pages/employer/publish/index" class="nav-chip">
        <text class="nav-chip-title">发布任务</text>
      </navigator>
      <navigator url="/pages/employer/tasks/index" class="nav-chip nav-chip-active">
        <text class="nav-chip-title">任务管理</text>
      </navigator>
      <navigator url="/pages/employer/orders/index" class="nav-chip">
        <text class="nav-chip-title">订单管理</text>
      </navigator>
      <navigator url="/pages/employer/profile/index" class="nav-chip">
        <text class="nav-chip-title">雇主资料</text>
      </navigator>
    </view>
  </view>

  <view class="section">
    <view class="list-stack">
      <view wx:for="{{tasks}}" wx:key="id" class="list-card">
        <view class="tag-row">
          <text class="tag">{{item.type}}</text>
          <text class="status-pill {{item.className}}">{{item.text}}</text>
        </view>
        <text class="list-title">{{item.title}}</text>
        <text class="list-text">{{item.timeText}}</text>
        <text class="list-text">{{item.address}} · 报酬：¥{{item.salary}}</text>
        <text class="list-text">接单老人：{{item.elderlyLabel}}</text>
        <text class="list-text">{{item.hintText}}</text>
      </view>
    </view>
  </view>
</view>
