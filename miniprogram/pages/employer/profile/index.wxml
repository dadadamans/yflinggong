<view class="page">
  <view class="hero-card">
    <text class="eyebrow">雇主端</text>
    <text class="page-title">雇主资料</text>
    <text class="page-desc">用于维护雇主名称、联系电话和发布说明，任务和订单里展示的雇主名称会跟着这里同步更新。</text>
  </view>

  <view class="section">
    <view class="nav-strip nav-strip-four">
      <navigator url="/pages/employer/publish/index" class="nav-chip">
        <text class="nav-chip-title">发布任务</text>
      </navigator>
      <navigator url="/pages/employer/tasks/index" class="nav-chip">
        <text class="nav-chip-title">任务管理</text>
      </navigator>
      <navigator url="/pages/employer/orders/index" class="nav-chip">
        <text class="nav-chip-title">订单管理</text>
      </navigator>
      <navigator url="/pages/employer/profile/index" class="nav-chip nav-chip-active">
        <text class="nav-chip-title">雇主资料</text>
      </navigator>
    </view>
  </view>

  <view class="section">
    <view class="card form-card">
      <view class="input-group">
        <text class="input-label">雇主姓名</text>
        <input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="请输入雇主姓名" />
      </view>
      <view class="input-group">
        <text class="input-label">联系电话</text>
        <input class="input" value="{{form.mobile}}" data-field="mobile" bindinput="onInput" placeholder="请输入联系电话" />
      </view>
      <view class="input-group">
        <text class="input-label">雇主备注</text>
        <textarea class="textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="请输入备注说明"></textarea>
      </view>
      <button class="btn-primary btn-block" style="margin-top: 20rpx;" bindtap="saveProfile">保存资料</button>
    </view>
  </view>
</view>
