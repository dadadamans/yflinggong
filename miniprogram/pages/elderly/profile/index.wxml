<view class="page">
  <view class="hero-card">
    <text class="eyebrow">老人端</text>
    <text class="page-title">个人中心</text>
    <text class="page-desc">这里用于填写老人基础资料、技能标签和紧急联系人信息，子女绑定后会读取这里的数据展示。</text>
  </view>

  <view class="section">
    <view class="card form-card">
      <view class="input-group">
        <text class="input-label">姓名</text>
        <input class="input" value="{{form.realName}}" data-field="realName" bindinput="onInput" placeholder="请输入姓名" />
      </view>
      <view class="input-group">
        <text class="input-label">手机号</text>
        <input class="input" value="{{form.mobile}}" data-field="mobile" bindinput="onInput" placeholder="请输入手机号" />
      </view>
      <view class="input-group">
        <text class="input-label">年龄</text>
        <input class="input" value="{{form.age}}" data-field="age" bindinput="onInput" placeholder="请输入年龄" />
      </view>
      <view class="input-group">
        <text class="input-label">性别</text>
        <input class="input" value="{{form.gender}}" data-field="gender" bindinput="onInput" placeholder="请输入性别" />
      </view>
      <view class="input-group">
        <text class="input-label">所在地区</text>
        <input class="input" value="{{form.city}}" data-field="city" bindinput="onInput" placeholder="请输入所在地区" />
      </view>
      <view class="input-group">
        <text class="input-label">健康情况</text>
        <textarea class="textarea" value="{{form.healthDesc}}" data-field="healthDesc" bindinput="onInput" placeholder="请输入健康说明"></textarea>
      </view>
      <view class="input-group">
        <text class="input-label">技能标签</text>
        <input class="input" value="{{form.skillTags}}" data-field="skillTags" bindinput="onInput" placeholder="如：陪诊、做饭、买菜" />
      </view>
      <view class="input-group">
        <text class="input-label">紧急联系人</text>
        <input class="input" value="{{form.emergencyContact}}" data-field="emergencyContact" bindinput="onInput" placeholder="请输入联系人姓名" />
      </view>
      <view class="input-group">
        <text class="input-label">紧急联系电话</text>
        <input class="input" value="{{form.emergencyMobile}}" data-field="emergencyMobile" bindinput="onInput" placeholder="请输入联系电话" />
      </view>
      <button class="btn-primary btn-block" style="margin-top: 20rpx;" bindtap="saveProfile">保存资料</button>
    </view>
  </view>
</view>
