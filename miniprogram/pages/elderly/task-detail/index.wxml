<view class="page" wx:if="{{task}}">
  <view class="hero-card">
    <text class="eyebrow">任务详情</text>
    <text class="page-title">{{task.title}}</text>
    <text class="page-desc">确认任务时间、地址和报酬后再操作，适合答辩时直接展示“查看详情 -> 接单 -> 生成订单”的完整链路。</text>
  </view>

  <view class="section">
    <view class="task-card">
      <view class="tag-row">
        <text class="tag">{{task.type}}</text>
        <text class="status-pill {{task.className}}">{{task.text}}</text>
      </view>
      <text class="task-title">任务信息</text>
      <text class="task-text">时间：{{task.timeText}}</text>
      <text class="task-text">地点：{{task.address}}</text>
      <text class="task-text">说明：{{task.content}}</text>
      <text class="task-text">雇主：{{task.publisherName}}</text>
      <text class="task-text">接单人：{{task.elderlyLabel}}</text>
      <view class="task-footer">
        <text class="price">{{task.salaryText}}</text>
        <button class="{{task.actionButtonClass}}" bindtap="handleAction">{{task.actionButtonText}}</button>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{task.order}}">
    <view class="list-card">
      <text class="list-title">关联订单</text>
      <text class="list-text">订单号：{{task.order.code}}</text>
      <text class="list-text">状态：{{task.order.text}}</text>
      <text class="list-text">结算：{{task.order.settleText}}</text>
    </view>
  </view>
</view>
