<view class="page">
  <view class="hero-card">
    <text class="eyebrow">老人端</text>
    <text class="page-title">{{profile.realName}}，您好</text>
    <text class="page-desc">今天有 {{waitingCount}} 个任务可接，{{activeCount}} 个任务正在服务中。点击任务卡片可以进入详情页确认地点、报酬和接单状态。</text>
  </view>

  <view class="section">
    <view class="quick-grid">
      <navigator url="/pages/elderly/tasks/index" class="quick-card">
        <text class="quick-title">任务大厅</text>
        <text class="quick-subtitle">查看全部任务</text>
      </navigator>
      <navigator url="/pages/elderly/orders/index" class="quick-card">
        <text class="quick-title">我的订单</text>
        <text class="quick-subtitle">查看订单状态</text>
      </navigator>
      <navigator url="/pages/elderly/profile/index" class="quick-card">
        <text class="quick-title">个人中心</text>
        <text class="quick-subtitle">维护资料和技能</text>
      </navigator>
      <navigator url="/pages/bind/index" class="quick-card">
        <text class="quick-title">子女绑定</text>
        <text class="quick-subtitle">生成绑定码</text>
      </navigator>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">任务列表</text>
      <text class="section-link">点击查看详情</text>
    </view>
    <view class="list-stack">
      <view wx:for="{{tasks}}" wx:key="id" class="task-card">
        <view class="tag-row">
          <text class="tag">{{item.type}}</text>
          <text class="status-pill {{item.className}}">{{item.text}}</text>
        </view>
        <text class="task-title">{{item.title}}</text>
        <text class="task-text">时间：{{item.timeText}}</text>
        <text class="task-text">地点：{{item.address}}</text>
        <text class="task-text">雇主：{{item.publisherName}}</text>
        <view class="task-footer">
          <text class="price">{{item.salaryText}}</text>
          <button class="{{item.actionClass}}" data-id="{{item.id}}" bindtap="goDetail">{{item.actionText}}</button>
        </view>
      </view>
    </view>
  </view>
</view>
