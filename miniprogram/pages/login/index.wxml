<view class="page">
  <view class="hero-card">
    <text class="eyebrow">登录 / 注册</text>
    <text class="page-title">银发零工</text>
    <text class="page-desc">先用微信身份进入，再登记基础资料并选择当前身份。选择老人就是老人端，选择子女就是子女端，选择雇主就是雇主端。</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">选择身份</text>
      <text class="section-link">登记当前角色</text>
    </view>
    <view class="card-stack">
      <view
        wx:for="{{roleOptions}}"
        wx:key="value"
        class="option-card {{item.activeClass}}"
        data-role="{{item.value}}"
        bindtap="selectRole"
      >
        <text class="quick-title">{{item.title}}</text>
        <text class="quick-subtitle">{{item.subtitle}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="card form-card">
      <view class="input-group">
        <text class="input-label">昵称</text>
        <input class="input" value="{{form.nickname}}" data-field="nickname" bindinput="onInput" placeholder="请输入昵称" />
      </view>
      <view class="input-group">
        <text class="input-label">手机号</text>
        <input class="input" value="{{form.mobile}}" data-field="mobile" bindinput="onInput" placeholder="请输入手机号" />
      </view>
      <button class="btn-primary btn-block" style="margin-top: 20rpx;" bindtap="submitLogin">登录并进入</button>
    </view>
  </view>
</view>
