<view class="page">
  <view class="hero-card">
    <text class="eyebrow">子女端</text>
    <text class="page-title">发布任务</text>
    <text class="page-desc">子女也可以替家里发布陪诊、照护、买菜等需求。这个页面只负责子女身份发布，不和查看资料、订单混在一起。</text>
  </view>

  <view class="section">
    <view class="nav-strip nav-strip-four">
      <navigator url="/pages/bind/index" class="nav-chip">
        <text class="nav-chip-title">绑定老人</text>
      </navigator>
      <navigator url="/pages/child/publish/index" class="nav-chip nav-chip-active">
        <text class="nav-chip-title">发布任务</text>
      </navigator>
      <navigator url="/pages/child/profile/index" class="nav-chip">
        <text class="nav-chip-title">老人资料</text>
      </navigator>
      <navigator url="/pages/child/orders/index" class="nav-chip">
        <text class="nav-chip-title">订单查看</text>
      </navigator>
    </view>
  </view>

  <view class="section">
    <view class="nav-strip">
      <navigator url="/pages/child/messages/index" class="nav-chip">
        <text class="nav-chip-title">留言沟通</text>
      </navigator>
      <navigator url="/pages/home/index" class="nav-chip">
        <text class="nav-chip-title">工作台</text>
      </navigator>
      <view></view>
    </view>
  </view>

  <view class="section">
    <view class="card form-card">
      <view class="input-group">
        <text class="input-label">任务标题</text>
        <input class="input" value="{{form.title}}" data-field="title" bindinput="onInput" placeholder="请输入任务标题" />
      </view>
      <view class="input-group">
        <text class="input-label">任务类型</text>
        <input class="input" value="{{form.type}}" data-field="type" bindinput="onInput" placeholder="请输入任务类型" />
      </view>
      <view class="input-group">
        <text class="input-label">服务时间</text>
        <input class="input" value="{{form.timeText}}" data-field="timeText" bindinput="onInput" placeholder="请输入服务时间" />
      </view>
      <view class="input-group">
        <text class="input-label">任务地址</text>
        <input class="input" value="{{form.address}}" data-field="address" bindinput="onInput" placeholder="请输入任务地址" />
      </view>
      <view class="input-group">
        <text class="input-label">报酬金额</text>
        <input class="input" type="number" value="{{form.salary}}" data-field="salary" bindinput="onInput" placeholder="请输入报酬金额" />
      </view>
      <view class="input-group">
        <text class="input-label">任务说明</text>
        <textarea class="textarea" value="{{form.content}}" data-field="content" bindinput="onInput" placeholder="请输入任务说明"></textarea>
      </view>
      <button class="btn-primary btn-block" style="margin-top: 20rpx;" bindtap="submitTask">发布任务</button>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">我发布的任务</text>
      <text class="section-link">子女身份</text>
    </view>
    <view class="list-stack">
      <view wx:for="{{tasks}}" wx:key="id" class="list-card">
        <view class="tag-row">
          <text class="tag">{{item.type}}</text>
          <text class="status-pill {{item.className}}">{{item.text}}</text>
        </view>
        <text class="list-title">{{item.title}}</text>
        <text class="list-text">{{item.timeText}}</text>
        <text class="list-text">{{item.address}} · 报酬：¥{{item.salary}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">相关订单</text>
      <text class="section-link">自动同步</text>
    </view>
    <view class="list-stack">
      <view wx:for="{{orders}}" wx:key="id" class="list-card">
        <view class="tag-row">
          <text class="soft-badge">{{item.code}}</text>
          <text class="status-pill {{item.className}}">{{item.text}}</text>
        </view>
        <text class="list-title">{{item.title}}</text>
        <text class="list-text">接单老人：{{item.elderlyName}}</text>
        <text class="list-text">开始时间：{{item.startTime}}</text>
        <text class="list-text">结算说明：{{item.settleText}}</text>
      </view>
    </view>
  </view>
</view>
