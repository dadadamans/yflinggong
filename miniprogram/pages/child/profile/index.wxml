<view class="page">
  <view class="hero-card">
    <text class="eyebrow">子女端</text>
    <text class="page-title">老人资料</text>
    <text class="page-desc">这里单独展示老人资料，只看姓名、年龄、技能、健康情况和紧急联系人，不混入订单和留言操作。</text>
  </view>

  <view class="section">
    <view class="nav-strip nav-strip-four">
      <navigator url="/pages/bind/index" class="nav-chip">
        <text class="nav-chip-title">绑定老人</text>
      </navigator>
      <navigator url="/pages/child/publish/index" class="nav-chip">
        <text class="nav-chip-title">发布任务</text>
      </navigator>
      <navigator url="/pages/child/profile/index" class="nav-chip nav-chip-active">
        <text class="nav-chip-title">老人资料</text>
      </navigator>
      <navigator url="/pages/child/orders/index" class="nav-chip">
        <text class="nav-chip-title">订单查看</text>
      </navigator>
    </view>
  </view>

  <view class="section">
    <view class="nav-strip">
      <navigator url="/pages/child/messages/index" class="nav-chip">
        <text class="nav-chip-title">留言沟通</text>
      </navigator>
      <navigator url="/pages/home/index" class="nav-chip">
        <text class="nav-chip-title">工作台</text>
      </navigator>
      <view></view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">绑定状态</text>
      <text class="section-link">{{bindStatusText}}</text>
    </view>
    <view class="card">
      <text class="list-title">{{profile.realName}}，{{profile.age}} 岁</text>
      <text class="list-text">所在地区：{{profile.city}}</text>
      <text class="list-text">技能标签：{{profile.skillText}}</text>
      <text class="list-text">健康情况：{{profile.healthDesc}}</text>
      <text class="list-text">紧急联系人：{{profile.emergencyContact}} {{profile.emergencyMobile}}</text>
    </view>
  </view>
</view>
