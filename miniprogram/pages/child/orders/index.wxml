<view class="page">
  <view class="hero-card">
    <text class="eyebrow">子女端</text>
    <text class="page-title">订单查看</text>
    <text class="page-desc">这里专门看老人当前接单情况和历史订单状态，不再和资料页、留言页混在同一个页面里。</text>
  </view>

  <view class="section">
    <view class="nav-strip nav-strip-four" style="margin-bottom: 18rpx;">
      <navigator url="/pages/bind/index" class="nav-chip">
        <text class="nav-chip-title">绑定老人</text>
      </navigator>
      <navigator url="/pages/child/publish/index" class="nav-chip">
        <text class="nav-chip-title">发布任务</text>
      </navigator>
      <navigator url="/pages/child/profile/index" class="nav-chip">
        <text class="nav-chip-title">老人资料</text>
      </navigator>
      <navigator url="/pages/child/orders/index" class="nav-chip nav-chip-active">
        <text class="nav-chip-title">订单查看</text>
      </navigator>
    </view>
    <view class="nav-strip">
      <navigator url="/pages/child/messages/index" class="nav-chip">
        <text class="nav-chip-title">留言沟通</text>
      </navigator>
      <navigator url="/pages/home/index" class="nav-chip">
        <text class="nav-chip-title">工作台</text>
      </navigator>
      <view></view>
    </view>
  </view>

  <view class="section" wx:if="{{currentOrder}}">
    <view class="section-head">
      <text class="section-title">当前进行中</text>
      <text class="section-link">{{currentOrder.text}}</text>
    </view>
    <view class="list-card">
      <text class="list-title">{{currentOrder.title}}</text>
      <text class="list-text">开始时间：{{currentOrder.startTime}}</text>
      <text class="list-text">服务地点：{{currentOrder.address}}</text>
      <text class="list-text">结算说明：{{currentOrder.settleText}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">全部订单</text>
      <text class="section-link">同步老人端</text>
    </view>
    <view class="list-stack">
      <view wx:for="{{orders}}" wx:key="id" class="list-card">
        <view class="tag-row">
          <text class="soft-badge">{{item.code}}</text>
          <text class="status-pill {{item.className}}">{{item.text}}</text>
        </view>
        <text class="list-title">{{item.title}}</text>
        <text class="list-text">开始时间：{{item.startTime}}</text>
        <text class="list-text">完成时间：{{item.finishText}}</text>
        <text class="list-text">订单说明：{{item.settleText}}</text>
      </view>
    </view>
  </view>
</view>
