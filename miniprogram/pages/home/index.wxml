<view class="page">
  <view class="hero-card">
    <text class="eyebrow">银发零工</text>
    <text class="page-title">{{overview.roleSummary.title}}</text>
    <text class="page-desc">{{overview.roleSummary.desc}}</text>
    <view class="summary-grid" style="margin-top: 24rpx;">
      <view wx:for="{{overview.stats}}" wx:key="label" class="summary-card">
        <text class="summary-value">{{item.value}}</text>
        <text class="summary-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">快捷入口</text>
      <text class="section-link">{{overview.currentProfileName}}</text>
    </view>
    <view class="role-grid">
      <navigator wx:for="{{quickEntries}}" wx:key="title" url="{{item.url}}" class="quick-card">
        <text class="quick-title">{{item.title}}</text>
        <text class="quick-subtitle">{{item.subtitle}}</text>
      </navigator>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">角色说明</text>
      <text class="section-link">{{overview.currentRoleText}}</text>
    </view>
    <view class="notice-card">
      <text class="notice-title">当前端的职责边界</text>
      <text class="notice-text">{{overview.roleSummary.desc}}</text>
    </view>
  </view>

  <view class="section">
    <button class="btn-primary btn-block" bindtap="goLogin">切换登录身份</button>
    <button class="btn-light btn-block" style="margin-top: 16rpx;" bindtap="resetDemoData">恢复初始演示数据</button>
  </view>
</view>
